
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/|@vite/|@id/|@fs/|@react-refresh|src/|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/radar-tech",
      "schedule": "0 12 * * *"
    }
  ]
}
